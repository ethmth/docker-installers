https://lumiere-dev.e-mini.internal {
    tls /certs/lumiere-dev.e-mini.internal.crt /certs/lumiere-dev.e-mini.internal.key {
		on_demand
	}

    header Access-Control-Allow-Origin *
    header Access-Control-Allow-Methods *
    header Access-Control-Allow-Headers *
    header Access-Control-Expose-Headers *

    @options method OPTIONS
    handle @options {
        respond 204
    }

    reverse_proxy http://host.docker.internal:24600
}